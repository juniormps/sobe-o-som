generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(uuid()) @db.Uuid
  name          String?   @db.VarChar(120)
  email         String    @unique @db.VarChar(320)
  emailVerified DateTime? @db.Timestamptz(3)
  image         String?   @db.VarChar(2048)
  passwordHash  String?   @db.VarChar(255)
  accounts      Account[]
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(3)
}

model Account {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @db.Uuid
  type              String   @db.VarChar(40)
  provider          String   @db.VarChar(80)
  providerAccountId String   @db.VarChar(255)
  refresh_token     String?  @db.Text
  access_token      String?  @db.Text
  expires_at        Int?
  token_type        String?  @db.VarChar(40)
  scope             String?  @db.Text
  id_token          String?  @db.Text
  session_state     String?  @db.VarChar(255)
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  createdAt         DateTime @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @db.Timestamptz(3)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Category {
  id        String    @id @default(uuid()) @db.Uuid
  name      String    @unique @db.VarChar(80)
  slug      String    @unique @db.VarChar(80)
  products  Product[]
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
}

model Product {
  id                    String   @id @default(uuid()) @db.Uuid
  categoryId            String   @db.Uuid
  name                  String   @db.VarChar(160)
  slug                  String   @unique @db.VarChar(180)
  artist                String   @db.VarChar(120)
  releaseYear           Int      @db.SmallInt
  description           String   @db.Text
  coverPath             String   @db.VarChar(255)
  priceInCents          Int
  referencePriceInCents Int?
  isActive              Boolean  @default(true)
  createdAt             DateTime @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime @updatedAt @db.Timestamptz(3)
  category              Category @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([categoryId, isActive, name])
  @@index([isActive, referencePriceInCents])
}
